// Prisma schema – SQLite for local demo (use postgresql in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PUBLIC
  LITIGANT
  ADVOCATE
  COURT_STAFF
  JUDGE
  ADMIN
  SUPER_ADMIN
}

enum CaseStatus {
  FILED
  REGISTERED
  PENDING
  ADMITTED
  HEARING
  RESERVED
  DISPOSED
  DISMISSED
  WITHDRAWN
  TRANSFERRED
}

enum PartyType {
  PETITIONER
  RESPONDENT
  APPELLANT
  APPLICANT
  OPPOSITE_PARTY
  OTHER
}

enum FilingStatus {
  DRAFT
  SUBMITTED
  UNDER_SCRUTINY
  ACCEPTED
  RETURNED
  REJECTED
  REGISTERED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  mobile        String?   @unique
  passwordHash  String?
  role          UserRole  @default(LITIGANT)
  isVerified    Boolean   @default(false)
  kycStatus     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  advocate      Advocate?
  filings       Filing[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Advocate {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  enrollmentNo   String   @unique
  barCouncil     String?
  practiceCourts String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  caseAdvocates CaseAdvocate[]
}

model CourtComplex {
  id        String  @id @default(cuid())
  name      String
  address   String?
  district  String?
  state     String?
  latitude  Float?
  longitude Float?
  contact   String?
  courts    Court[]
}

model Court {
  id           String  @id @default(cuid())
  name         String
  type         String
  complexId    String?
  complex      CourtComplex? @relation(fields: [complexId], references: [id])
  jurisdiction String?
  isActive     Boolean @default(true)

  cases      Case[]
  causeLists CauseList[]
  judges     Judge[]
}

model Judge {
  id          String  @id @default(cuid())
  name        String
  designation String?
  courtId     String?
  court       Court?  @relation(fields: [courtId], references: [id])
  isActive    Boolean @default(true)

  hearings Hearing[]
}

model Case {
  id               String     @id @default(cuid())
  cnr              String     @unique
  caseNumber       String
  caseType         String
  filingDate       DateTime?
  registrationDate DateTime?
  status           CaseStatus @default(FILED)
  stage            String?
  courtId          String
  court            Court      @relation(fields: [courtId], references: [id])
  nextHearingDate  DateTime?
  disposedDate     DateTime?
  subject          String?
  acts             String?

  parties   CaseParty[]
  advocates CaseAdvocate[]
  hearings  Hearing[]
  orders    OrderJudgment[]
  filings   Filing[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaseParty {
  id      String    @id @default(cuid())
  caseId  String
  case    Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name    String
  type    PartyType
  address String?
  age     Int?
  gender  String?
}

model CaseAdvocate {
  id         String    @id @default(cuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  advocateId String?
  advocate   Advocate? @relation(fields: [advocateId], references: [id])
  name       String?
  side       String
  isLead     Boolean   @default(false)
}

model Hearing {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hearingDate DateTime
  stage       String?
  judgeId     String?
  judge       Judge?   @relation(fields: [judgeId], references: [id])
  courtroom   String?
  purpose     String?
  remarks     String?
  isCompleted Boolean  @default(false)
}

model OrderJudgment {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderDate   DateTime
  type        String
  title       String?
  pdfUrl      String
  isFinal     Boolean   @default(false)
  publishedAt DateTime?
  uploadedBy  String?
}

model Filing {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  caseId       String?
  case         Case?        @relation(fields: [caseId], references: [id])
  filingType   String
  status       FilingStatus @default(DRAFT)
  caseType     String?
  subject      String?
  feeAmount    Float?
  paymentId    String?
  submittedAt  DateTime?
  acceptedAt   DateTime?
  cnrGenerated String?
  remarks      String?

  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         String   @id @default(cuid())
  filingId   String?
  filing     Filing?  @relation(fields: [filingId], references: [id])
  caseId     String?
  case       Case?    @relation(fields: [caseId], references: [id])
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int?
  uploadedAt DateTime @default(now())
  isPublic   Boolean  @default(false)
}

model CauseList {
  id          String    @id @default(cuid())
  courtId     String
  court       Court     @relation(fields: [courtId], references: [id])
  listDate    DateTime
  judgeId     String?
  courtroom   String?
  items       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Float
  currency   String   @default("INR")
  purpose    String
  status     String
  gatewayRef String?
  receiptUrl String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())
}

model NewsCircular {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  type        String
  publishedAt DateTime?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
